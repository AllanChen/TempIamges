# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Xcode user-local
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside

# Build outputs
build/
DerivedData/
.build/
.swiftpm/
Package.resolved
*.hmap
*.ipa
*.dSYM
*.dSYM.zip

# Built app bundle (build.sh writes this under clients/macos)
/clients/macos/Glance.app/

# Debug build output
clients/macos/Glance/debug/

# Claude session data
.claude/

# prototype: keep sources, drop compiled binaries
clients/macos/prototypes/*
!clients/macos/prototypes/*.swift
!clients/macos/prototypes/*.sh
!clients/macos/prototypes/*.html
!clients/macos/prototypes/.gitignore
.gstack/

# Cloudflare Pages build output
dist/

# Local tool state
.wrangler/
website/app/.openai/
__pycache__/
.venv/
*.py[cod]
*.egg-info/
.glance-test-output/

# Local upload provider credentials
design/app/specs/plans/upload_info.txt

# Release artifacts (publish via GitHub Releases / Sparkle, not git)
*.dmg

# Local legacy project and session state
/clients/macos/legacy/ImageHoverPreview/
/docs/archive/local-state/

# Keep dependency locks after moving them (override global lockfile ignores)
!/server/GlanceService/package-lock.json
!/website/app/package-lock.json

# Local payment credentials; never commit.
/infomation/info.txt
/infomation/sparkle-update-key.txt

# Local credentials (never commit)
/account_info.txt
